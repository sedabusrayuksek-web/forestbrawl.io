# ForestBrawl.io Environment Configuration
# Copy to .env.production and set your own values

# Server Configuration
NODE_ENV=production
PORT=8080

# Security
# ⚠️  IMPORTANT: Generate a strong random string for production
# You can generate one with: openssl rand -base64 32
SESSION_SECRET=your-super-secret-jwt-signing-key-change-this-in-production

# Optional: Database (for future implementation)
# DATABASE_URL=postgresql://user:password@localhost/forestbrawl

# Optional: Analytics
# SENTRY_DSN=https://your-sentry-url
